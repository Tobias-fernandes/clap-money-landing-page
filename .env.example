# Public URL of this landing page (no trailing slash). Used for canonical
# URLs, the sitemap, robots.txt and Open Graph. Defaults to production.
# NEXT_PUBLIC_SITE_URL=https://clapmoney.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000/

# URL of the ClapMoney web app (no trailing slash). "Entrar" and
# "Criar conta grátis" point here.
# NEXT_PUBLIC_APP_URL=https://app.clapmoney.com.br
NEXT_PUBLIC_APP_URL=http://localhost:5173/

# Google Analytics 4 measurement ID (web stream of clapmoney.com.br).
# Loads only on the production deployment and only after the visitor
# accepts cookies. Leave empty to turn analytics off.
NEXT_PUBLIC_GA_ID=G-Y6BWPQT47Q
